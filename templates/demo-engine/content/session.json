      ],
      "choices": [
        {
          "label": "Replay from the start",
          "kind": "restart",
          "goto": "match"
        }
      ],
      "auto": "match"
    },
    {
      "id": "declined",
      "stage": "Declined",
      "caption": "Declined: nothing is posted, and the plan is kept for the record.",
      "events": [
        {
          "type": "out",
          "lines": [
            "[[err:declined]] by the controller on duty",
            "  posted: 0 · plan archived with the reason"
