{
  "title": "Acme Ledger: matching a month-end close",
  "badge": "Recreated, not live",
  "label": "A scripted recreation with fictional data. Nothing here runs live.",
  "footer": "Fictional product, data and figures. Session script: content/session.json.",
  "prompt": "finance@close:~$ ",
  "timing": {
    "type_cps": 38,
    "enter_ms": 250,
    "line_ms": 90,
    "hold_ms": 2200
